# intel-ucode
# udev hibernate

mkdir -p ~/builds
cd ~/builds
git clone https://aur.archlinux.org/aurutils-git.git
makepkg -sri

aur sync reflector
sudo pacman -S reflector

sudo reflector --latest 15 --protocol http --protocol https --sort rate --save /etc/pacman.d/mirrorlist

cd ~/dotfiles

sudo mkdir -p /etc/pacman.d/hooks
sudo cp ~/dotfiles/mirrorupgrade.hook /etc/pacman.d/hooks

# set makeflags

PKGS="i3-wm i3status picom feh kitty xorg-xsetroot xdo pavucontrol libpulse gnome-screenshot vim ranger xsel stow tmux zsh pass ripgrep tokei fzf xfce-panel xfce4-terminal xfce4-battery-plugin rofi arandr adapta-gtk-theme xorg-server xorg-xinit xorg-xmodmap networkmanager networkmanager-openvpn network-manager-applet pulseaudio ctags firefox"
AUR="sct brillo unclutter-xfixes-git betterlockscreen rofi-pass numix-circle-icon-theme-git"

aur sync $AUR

sudo pacman -S $PKGS $AUR

systemctl enable NetworkManager

stow vim
mkdir -p ~/.config

git clone https://github.com/tarjoilija/zgen.git ~/.zgen
stow zsh
sudo chsh "$USER" -s "$(which zsh)"

# font rendering (subpixel rgb, lcdfilter, hintslight) is set in X/.config/fontconfig/fonts.conf

stow X
stow i3
feh --bg-fill ~/.background.png
betterlockscreen -u ~/.background.png
stow git
stow xfce
stow zathura

# to get brillo to work, gpasswd -a henry video and restart
# for spotify to play local files install aur/ffmpeg-compat-54

# for kak (i don't remember if this also fixes it for vim in tmux)
# This sets up terminfo overrides properly so that kakoune colors work within tmux
# Taken from kakoune faq :doc faq
# $ curl -O https://raw.githubusercontent.com/mawww/kakoune/master/contrib/tmux-256color.terminfo
# $ tic tmux-256color.terminfo
