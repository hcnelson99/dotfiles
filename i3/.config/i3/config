# i3 config, ported from bspwm/sxhkd

set $mod Mod4

font pango:DejaVu Sans Bold 10

#
# Autostart
#

exec --no-startup-id xsetroot -cursor_name left_ptr
exec --no-startup-id sh ~/.fehbg
exec --no-startup-id picom -b
exec --no-startup-id nm-applet
exec --no-startup-id kitty --class scratchpad

#
# Appearance
#

default_border pixel 2
default_floating_border pixel 2
gaps inner 0

# class                 border  bground text    indicator child_border
client.focused          #707880 #707880 #dfdfdf #707880   #707880
client.focused_inactive #37474F #37474F #dfdfdf #37474F   #37474F
client.unfocused        #37474F #37474F #888888 #37474F   #37474F
client.urgent           #bd2c40 #bd2c40 #dfdfdf #bd2c40   #bd2c40

#
# Behaviour
#

focus_follows_mouse yes
floating_modifier $mod

for_window [class="Pinentry"] floating enable
for_window [class="wineconsole.exe"] floating enable

for_window [class="scratchpad"] move scratchpad

#
# General
#

bindsym XF86AudioRaiseVolume exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ false ; exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +5%
bindsym XF86AudioLowerVolume exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ false ; exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -5%
bindsym XF86AudioMute exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ toggle

bindsym XF86MonBrightnessUp exec --no-startup-id brillo -equ 1500 -A 5%
bindsym XF86MonBrightnessDown exec --no-startup-id brillo -equ 1500 -U 5%

# terminal emulator
bindsym $mod+Return exec xfce4-terminal

# scratchpad terminal
bindsym $mod+Shift+Return [class="scratchpad"] scratchpad show

# browser
bindsym $mod+c exec firefox

# pass
bindsym $mod+p exec rofi -modi 1pass:rofi-1pass -show 1pass

# pavucontrol
bindsym $mod+a exec pavucontrol

# lock
bindsym $mod+Escape exec --no-startup-id betterlockscreen -s

# program launcher
bindsym $mod+d exec rofi -show run

# flip the split direction of the parent container
bindsym $mod+r layout toggle split

# restart i3 in place (re-reads config, keeps layout)
bindsym $mod+Shift+r restart

bindsym $mod+n exec --no-startup-id sct 3000
bindsym $mod+Shift+n exec --no-startup-id sct

bindsym $mod+g exec sudo gpu_fix_artifacts.sh

bindsym $mod+Shift+s exec gnome-screenshot -i

#
# i3 hotkeys
#

# quit i3
bindsym $mod+Shift+e exit

# close and kill
bindsym $mod+q kill
bindsym $mod+Shift+q exec --no-startup-id xdo kill

#
# state/flags
#

bindsym $mod+t floating disable
bindsym $mod+s floating enable
bindsym $mod+f fullscreen toggle

bindsym $mod+ctrl+y sticky toggle

#
# focus/swap
#

# focus the window in the given direction
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

# move the window in the given direction
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

# focus or send to the next/previous workspace
bindsym $mod+bracketleft workspace prev_on_output
bindsym $mod+bracketright workspace next_on_output
bindsym $mod+Shift+bracketleft move container to workspace prev_on_output
bindsym $mod+Shift+bracketright move container to workspace next_on_output

# focus the last workspace
bindsym $mod+Tab workspace back_and_forth

# focus / move to the other monitor
bindsym $mod+grave focus output right
bindsym $mod+Shift+grave move container to output right

# focus or send to the given workspace
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10

bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10

#
# split (replaces bspwm preselection)
#

bindsym $mod+ctrl+h split h
bindsym $mod+ctrl+l split h
bindsym $mod+ctrl+j split v
bindsym $mod+ctrl+k split v

#
# bar
#

bindsym $mod+space bar mode invisible
bindsym $mod+Shift+space bar mode dock

bar {
    status_command i3status
    position bottom
    tray_output primary
    font pango:DejaVu Sans Bold 10

    colors {
        background #171e2c
        statusline #dfdfdf
        separator  #555555

        #                  border  bground text
        focused_workspace  #444444 #444444 #dfdfdf
        active_workspace   #171e2c #171e2c #dfdfdf
        inactive_workspace #171e2c #171e2c #dfdfdf
        urgent_workspace   #bd2c40 #bd2c40 #dfdfdf
    }
}
